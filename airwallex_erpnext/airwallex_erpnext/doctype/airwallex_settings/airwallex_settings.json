{
  "doctype": "DocType",
  "name": "Airwallex Settings",
  "module": "Airwallex ERPNext",
  "custom": 0,
  "istable": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "engine": "InnoDB",
  "field_order": [
    "settings_name",
    "enabled",
    "environment_section",
    "environment",
    "api_base_url",
    "client_id",
    "api_key",
    "account_id",
    "legal_entity_id",
    "timeout_seconds",
    "column_break_connection",
    "company",
    "default_currency",
    "default_cost_center",
    "default_expense_account",
    "default_business_unit",
    "supplier_group",
    "default_expense_claim_type",
    "sync_section",
    "sync_start_date",
    "overlap_hours",
    "max_records_per_sync",
    "settled_only",
    "enable_banking",
    "enable_expenses",
    "enable_bills",
    "enable_supplier_payments",
    "enable_reimbursements",
    "enable_fx",
    "enable_transfers",
    "auto_provision_currency_accounts",
    "enable_fx_journals",
    "posting_section",
    "expense_posting_strategy",
    "create_accounting_documents",
    "submit_accounting_documents",
    "create_suppliers",
    "mark_expenses_synced",
    "mark_bills_synced",
    "webhook_section",
    "webhook_version",
    "webhook_tolerance_seconds",
    "webhook_max_attempts",
    "webhook_subscription_id",
    "webhook_subscription_status",
